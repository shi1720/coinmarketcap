rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/workspaces/{workspaceId} {
      allow read: if owner(uid) && workspaceId == 'current';
      allow create: if owner(uid) && workspaceId == 'current'
        && request.resource.data.keys().hasOnly(['payload', 'revision', 'updatedAt'])
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 150000
        && request.resource.data.revision == 1 && request.resource.data.updatedAt == request.time;
      allow update: if owner(uid) && workspaceId == 'current'
        && request.resource.data.keys().hasOnly(['payload', 'revision', 'updatedAt'])
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 150000
        && request.resource.data.revision is int && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /users/{uid}/reports/{reportId} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['payload', 'createdAt', 'clientCreatedAt', 'calculationOrigin'])
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 700000
        && request.resource.data.clientCreatedAt is string && request.resource.data.clientCreatedAt.size() <= 40
        && request.resource.data.createdAt == request.time
        && request.resource.data.calculationOrigin == 'browser';
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
